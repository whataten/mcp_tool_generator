{
  "schema_version": 1,
  "id": "login_internal_system",
  "name": "Login Internal System",
  "description": "사내 시스템에 로그인합니다. 로그인 직후 뜨는 안내 alert를 닫고 홈 화면까지 진입합니다.",
  "start_url": "http://localhost:8000/login.html",
  "variables": {
    "username": {
      "type": "string",
      "required": true,
      "description": "사내 시스템 로그인 아이디"
    },
    "password": {
      "type": "secret",
      "required": true,
      "description": "사내 시스템 로그인 비밀번호"
    }
  },
  "steps": [
    {
      "id": "enter_username",
      "action": "input",
      "target": {
        "selectors": [
          {
            "type": "css",
            "value": "#username-input"
          }
        ]
      },
      "value": {
        "type": "variable",
        "name": "username"
      },
      "wait_after": {
        "timeout_ms": 5000
      }
    },
    {
      "id": "enter_password",
      "action": "input",
      "target": {
        "selectors": [
          {
            "type": "css",
            "value": "#password-input"
          }
        ]
      },
      "value": {
        "type": "variable",
        "name": "password"
      },
      "wait_after": {
        "timeout_ms": 5000
      }
    },
    {
      "id": "click_login",
      "action": "click",
      "target": {
        "selectors": [
          {
            "type": "css",
            "value": "#login-btn"
          }
        ]
      },
      "wait_after": {
        "timeout_ms": 5000
      }
    },
    {
      "id": "close_notice_alert",
      "action": "alert",
      "alert_action": "accept",
      "extract_as": "login_notice",
      "wait_after": {
        "timeout_ms": 5000
      }
    },
    {
      "id": "read_welcome",
      "action": "extract",
      "target": {
        "selectors": [
          {
            "type": "css",
            "value": "#welcome"
          }
        ]
      },
      "options": {
        "extract_type": "text"
      },
      "extract_as": "welcome_message",
      "wait_before": {
        "timeout_ms": 8000,
        "wait_until": "selector_visible",
        "target": {
          "selectors": [
            {
              "type": "css",
              "value": "#welcome"
            }
          ]
        }
      },
      "wait_after": {
        "timeout_ms": 5000
      }
    },
    {
      "id": "verify_logged_in",
      "action": "assert",
      "target": {
        "selectors": [
          {
            "type": "css",
            "value": "#login-status"
          }
        ]
      },
      "options": {
        "assert_type": "visible"
      }
    }
  ],
  "outputs": [
    "login_notice",
    "welcome_message"
  ]
}
